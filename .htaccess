# =====================================================================
# Alamat rapi dan aturan keamanan — Website Portofolio Zulian
# Butuh Apache dengan mod_rewrite (sudah aktif di Laragon).
# Website harus berada di akar domain, misalnya http://portofolio.test/
# =====================================================================

Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8

# Halaman 404 buatan sendiri. Folder yang dilarang (403) juga tampil sebagai 404
# supaya orang lain tidak tahu folder itu ada.
ErrorDocument 404 /404.php
ErrorDocument 403 /404.php

# Batas unggah PHP (kode tetap membatasi: gambar 2 MB, CV 5 MB).
# Bagian ini untuk Laragon/Apache; hosting dengan PHP-FPM memakai file .user.ini.
<IfModule php_module>
    php_value upload_max_filesize 6M
    php_value post_max_size 40M
    php_value max_file_uploads 20
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # --- (Tahap 8, di hosting) Paksa HTTPS: hapus tanda # di dua baris bawah ---
    # RewriteCond %{HTTPS} !=on
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # --- Tolak file/folder tersembunyi (.git, .claude, .env, dll) ---
    RewriteRule (^|/)\.(?!well-known/) - [F,L]

    # --- Tolak folder internal: berisi kode, pengaturan, dan file database ---
    RewriteRule ^(config|includes|lang|database)(/|$) - [F,L]

    # --- Tolak file dokumen/catatan yang tidak perlu dibuka dari browser (kecuali robots.txt) ---
    RewriteCond %{REQUEST_URI} !^/robots\.txt$
    RewriteRule \.(md|sql|log|ini|lock|txt)$ - [F,L,NC]

    # --- Peta situs & aturan robot untuk mesin pencari (dibuat oleh PHP) ---
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
    RewriteRule ^robots\.txt$  robots.php  [L]

    # --- Halaman publik dua bahasa ---
    RewriteRule ^(id|en)/?$                       index.php?lang=$1          [L,QSA]
    RewriteRule ^(id|en)/projects/?$              projects.php?lang=$1       [L,QSA]
    RewriteRule ^(id|en)/project/([a-z0-9-]+)/?$  project.php?lang=$1&slug=$2 [L,QSA]
</IfModule>
